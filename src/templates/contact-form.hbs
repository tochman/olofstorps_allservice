<div class="blocks__single">
  <div class="form-container">
    <!-- Reply Group Start -->
    <div class="reply-group">
      <span class="material-icons txt-light">
        done
      </span>
      <p class="reply-group__title txt-light">
        <span>
          Done
        </span>
        !
      </p>
      <span class="reply-group__text txt-light-transparent">
        Tack för ditt meddelande. Vi återkommer till dig snarast.
      </span>
    </div>
    <!-- Reply Group End -->
    <!-- Contact Form Start -->
    <form
      class="form form-light contact-form"
      id="contact-form"
      name="site-contact-form"
      action="/"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <!-- Hidden Fields for Netlify -->
      <input type="hidden" name="form-name" value="site-contact-form" />
      <input type="hidden" name="bot-field" />

      <div class="container-fluid p-0">
        <div class="row gx-5">
          <div class="col-12 col-md-6">
            <input type="text" name="name" placeholder="Ditt namn*" required />
          </div>
          <div class="col-12 col-md-6">
            <input type="text" name="company" placeholder="Företag" />
          </div>
          <div class="col-12 col-md-6">
            <input type="email" name="email" placeholder="Email*" required />
          </div>
          <div class="col-12 col-md-6">
            <input
              type="tel"
              name="phone"
              placeholder="Telefonnummer*"
              required
            />
          </div>
          <div class="col-12">
            <textarea
              name="message"
              placeholder="Eventuellt meddelande"
            ></textarea>
          </div>
          <div class="col-12">
            <span class="inputs-description">
              *Obligatoriska fält
            </span>
            <button type="submit" class="button button-l button-light">
              <span class="button-caption">
                Skicka
              </span>
            </button>
          </div>
        </div>
      </div>
    </form>
    <!-- Contact Form End -->

    <!-- Error Group Start -->
    <div class="error-group">
      <span class="material-icons txt-light">
        error_outline
      </span>
      <p class="reply-group__title txt-light">
        <span>Fel</span>!
      </p>
      <span class="reply-group__text txt-light-transparent">
        Ett fel uppstod. Vänligen försök igen.
      </span>
    </div>
    <!-- Error Group End -->
  </div>
</div>
<!-- Contact Form Block End -->